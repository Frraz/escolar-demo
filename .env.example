# ==============================================================================
# Sistema Escolar Demo — variáveis de ambiente
# Copie este arquivo para ".env" e preencha os valores antes de subir o projeto.
# NUNCA versione o arquivo ".env" (ele já está no .gitignore).
# ==============================================================================

# --- Django -------------------------------------------------------------
# Gere uma chave forte, por exemplo com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Obrigatório em produção (settings/production.py) — origens HTTPS confiáveis
# para POST (login, formulários, HTMX). Ex: https://escolar-demo.ferzion.com.br
CSRF_TRUSTED_ORIGINS=
DJANGO_SETTINGS_MODULE=config.settings.local

# --- Banco de dados -------------------------------------------------------
# Formato: postgres://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=postgres://escolar:escolar@db:5432/escolar_demo

# --- Criptografia de campos sensíveis (tokens do Google) ------------------
# Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=change-me-generate-a-fernet-key

# --- Google OAuth 2.0 -------------------------------------------------------
# Criados no Google Cloud Console (ver README, seção "Configurando o Google Cloud").
# A conta Google usada deve ser a conta do CLIENTE, nunca uma conta pessoal do
# desenvolvedor — é nela que os arquivos e planilhas serão armazenados.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/google-drive/oauth2callback/
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/drive.file,https://www.googleapis.com/auth/spreadsheets

# --- Google Drive -----------------------------------------------------------
# ID da pasta raiz "Sistema Escolar" dentro do Google Drive do cliente.
# É o trecho final da URL da pasta: https://drive.google.com/drive/folders/<ESTE_ID>
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# --- Upload de arquivos -------------------------------------------------
MAX_UPLOAD_SIZE_MB=15
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.jpg,.jpeg,.png,.doc,.docx,.xls,.xlsx,.txt,.csv

# --- Diversos ---------------------------------------------------------------
TIME_ZONE=America/Sao_Paulo

# --- Portas do Docker Compose (opcional) -------------------------------
# Ajuste se as portas padrão já estiverem em uso na sua máquina.
# WEB_HOST_PORT=8010
# POSTGRES_HOST_PORT=5433
